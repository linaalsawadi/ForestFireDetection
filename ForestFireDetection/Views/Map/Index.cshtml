@{
    ViewData["Title"] = "Map";
}

<div class="row">
    <div class="col-12">
        <div class="card card-success card-outline">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title mb-0"><i class="fas fa-map-marked-alt me-2"></i>Live Map</h3>
                <div style="max-width:220px;">
                    <div class="input-group input-group-sm">
                        <input type="text" class="form-control" id="sensorSearch" placeholder="Sensor ID (e.g. SNS-001)">
                        <button class="btn btn-outline-secondary" type="button" onclick="document.getElementById('sensorSearch').dispatchEvent(new Event('keyup'))">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </div>
            </div>
            <div class="card-body p-0">
                <div id="map" style="height:calc(100vh - 220px);min-height:500px;border-radius:0 0 12px 12px;"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/map.js"></script>
}