@using ForestFireDetection.Models.Enums
@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var act = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Green Shield</title>
    <link rel="icon" type="image/png" sizes="512x512" href="~/assets/img/Logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <link rel="stylesheet" href="~/plugins/fontawesome-free/css/all.min.css" />
    <link rel="stylesheet" href="~/assets/vendor/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/dist/css/adminlte.min.css" />
    <link rel="stylesheet" href="~/css/greenshield-theme.css" />
    @RenderSection("Styles", required: false)
</head>
<body class="hold-transition sidebar-mini layout-fixed layout-navbar-fixed">
    <div class="wrapper">

        <!-- Navbar -->
        <nav class="main-header navbar navbar-expand navbar-light" style="background:#fff;border-bottom:1px solid var(--gs-gray-200);">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link px-3" data-widget="pushmenu" href="#" style="color:var(--gs-gray-500)"><i class="fas fa-bars"></i></a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <a asp-controller="Home" asp-action="Index" class="nav-link" style="color:var(--gs-gray-500)">
                        <i class="fas fa-home me-1"></i> Dashboard
                    </a>
                </li>
            </ul>
            <ul class="navbar-nav ml-auto align-items-center">
                <li class="nav-item">
                    <a class="nav-link position-relative" asp-controller="Alerts" asp-action="Index">
                        <i class="fas fa-bell fa-lg" style="color:var(--gs-gray-500)"></i>
                        <span class="badge bg-danger position-absolute translate-middle rounded-pill"
                              id="alert-count-badge" style="display:none;font-size:.6rem;top:5px;right:-2px;">0</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-widget="fullscreen" href="#" style="color:var(--gs-gray-500)"><i class="fas fa-expand-arrows-alt"></i></a>
                </li>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item">
                        <span class="nav-link" style="color:var(--gs-gray-500);font-size:.85rem;">
                            <i class="fas fa-user-circle me-1"></i>@User.Identity.Name
                        </span>
                    </li>
                    <li class="nav-item ms-1">
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 my-1" style="font-size:.78rem;">
                                <i class="bi bi-box-arrow-right me-1"></i>Logout
                            </button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="btn btn-success btn-sm rounded-pill px-3 my-1" asp-controller="Account" asp-action="Login">
                            <i class="fas fa-sign-in-alt me-1"></i>Login
                        </a>
                    </li>
                }
            </ul>
        </nav>

        <!-- Sidebar -->
        <aside class="main-sidebar elevation-4" style="background:var(--gs-sidebar-bg);">
            <a asp-controller="Home" asp-action="Index" class="brand-link text-center border-0" style="background:rgba(0,0,0,.2);padding:14px 8px;">
                <img src="~/assets/img/logo.png" alt="Logo" class="brand-image img-circle elevation-3" style="opacity:.9" />
                <span class="brand-text font-weight-bold" style="color:#6fcf6f;font-size:1.05rem;">Green Shield</span>
            </a>
            <div class="sidebar">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="user-panel mt-3 pb-3 mb-3 d-flex align-items-center" style="border-bottom:1px solid rgba(255,255,255,.06);">
                        <div class="image">
                            <div class="rounded-circle d-flex align-items-center justify-content-center"
                                 style="width:36px;height:36px;background:linear-gradient(135deg,var(--gs-green),#10b981);color:#fff;font-weight:700;font-size:.9rem;">
                                @(User.Identity.Name?[0].ToString().ToUpper())
                            </div>
                        </div>
                        <div class="info">
                            <a href="#" class="d-block text-light" style="font-size:.82rem;">@User.Identity.Name</a>
                            <small style="color:var(--gs-green);font-size:.68rem;">
                                <i class="fas fa-circle" style="font-size:.35rem;"></i>
                                @(User.IsInRole(UserRoles.Admin) ? "Administrator" : "Fire Station")
                            </small>
                        </div>
                    </div>
                }
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column nav-child-indent" data-widget="treeview" role="menu">
                        <li class="nav-item">
                            <a asp-controller="Home" asp-action="Index"
                               class="nav-link @(ctrl == "Home" ? "active" : "")">
                                <i class="nav-icon fas fa-tachometer-alt"></i><p>Dashboard</p>
                            </a>
                        </li>
                        @if (User.IsInRole(UserRoles.Admin))
                        {
                            <li class="nav-header">Management</li>
                            <li class="nav-item">
                                <a asp-controller="Users" asp-action="ListFireStations"
                                   class="nav-link @(ctrl == "Users" && act == "ListFireStations" ? "active" : "")">
                                    <i class="nav-icon fas fa-fire-extinguisher"></i><p>Fire Stations</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Users" asp-action="ListAdmin"
                                   class="nav-link @(ctrl == "Users" && act == "ListAdmin" ? "active" : "")">
                                    <i class="nav-icon fas fa-user-shield"></i><p>Administrators</p>
                                </a>
                            </li>
                            <li class="nav-header">Monitoring</li>
                            <li class="nav-item">
                                <a asp-controller="Sensors" asp-action="Index"
                                   class="nav-link @(ctrl == "Sensors" && act == "Index" ? "active" : "")">
                                    <i class="nav-icon fas fa-microchip"></i><p>Sensors</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Sensors" asp-action="Reports"
                                   class="nav-link @(ctrl == "Sensors" && (act == "Reports" || act == "DailyReport") ? "active" : "")">
                                    <i class="nav-icon fas fa-chart-bar"></i><p>Data Reports</p>
                                </a>
                            </li>
                        }
                        <li class="nav-header">Operations</li>
                        <li class="nav-item">
                            <a asp-controller="Alerts" asp-action="Index"
                               class="nav-link @(ctrl == "Alerts" ? "active" : "")">
                                <i class="nav-icon fas fa-fire-alt"></i>
                                <p>Alerts @await Component.InvokeAsync("PendingAlertCount")</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Map" asp-action="Index"
                               class="nav-link @(ctrl == "Map" ? "active" : "")">
                                <i class="nav-icon fas fa-map-marked-alt"></i><p>Live Map</p>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </aside>

        <!-- Content -->
        <div class="content-wrapper" style="background:#f8fafc;">
            <div class="content-header">
                <div class="container-fluid">
                    <div class="row mb-0">
                        <div class="col-sm-6">
                            <h1 class="m-0" style="font-size:1.35rem;font-weight:700;color:var(--gs-gray-900);">@ViewData["Title"]</h1>
                        </div>
                        <div class="col-sm-6">
                            <ol class="breadcrumb float-sm-right" style="font-size:.78rem;">
                                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" style="color:var(--gs-green);">Home</a></li>
                                <li class="breadcrumb-item active" style="color:var(--gs-gray-500);">@ViewData["Title"]</li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
            <section class="content">
                <div class="container-fluid">@RenderBody()</div>
            </section>
        </div>

        <footer class="main-footer" style="font-size:.82rem;">
            <strong>&copy; 2025 <span style="color:var(--gs-green);">Green Shield</span></strong> — Forest Fire Detection System
            <div class="float-right d-none d-sm-inline-block"><b>v</b>1.0.0</div>
        </footer>

        <!-- Control Sidebar for sensor detail -->
        <aside class="control-sidebar control-sidebar-dark">
            <div class="p-0" id="control-sidebar-content">
                <p id="sensor-title" class="font-weight-bold" style="color:#6fcf6f;display:none;">Sensor Info</p>
                <div id="sensor-panel-body">
                    <div style="padding:40px 20px;text-align:center;color:rgba(255,255,255,.4);">
                        <i class="fas fa-mouse-pointer" style="font-size:2rem;margin-bottom:12px;display:block;"></i>
                        <p style="font-size:.85rem;">Click a sensor on the map to view details</p>
                    </div>
                </div>
            </div>
        </aside>
    </div>

    <script src="~/plugins/jquery/jquery.min.js"></script>
    <script src="~/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/dist/js/adminlte.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/alert-handler.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <div class="toast-container position-fixed top-0 end-0 p-3" id="toastArea" style="z-index:1060;"></div>
    <audio id="fire-sound" src="/audio/alert.mp3" preload="auto"></audio>
    <div id="alert-overlay"></div>
</body>
</html>