@model IEnumerable<ApplicationUser>
@{
    ViewData["Title"] = "Fire Stations";
}

<div class="card card-success card-outline">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0"><i class="fas fa-fire-extinguisher me-2"></i>Fire Stations</h3>
        <div class="d-flex align-items-center gap-2">
            <div style="max-width:200px;">
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" class="form-control" id="fireStation" placeholder="Search...">
                </div>
            </div>
            <a asp-controller="Users" asp-action="Create" class="btn btn-success btn-sm">
                <i class="fas fa-plus me-1"></i>Add Station
            </a>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0" id="fireStationTable">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th class="text-center" style="width:140px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div style="display:flex;align-items:center;gap:10px;">
                                    <div class="gs-avatar" style="background:linear-gradient(135deg,var(--gs-green),#10b981);">
                                        @(item.FirstName?[0].ToString().ToUpper())@(item.LastName?[0].ToString().ToUpper())
                                    </div>
                                    <div>
                                        <div class="fw-bold" style="font-size:.875rem;">@item.FirstName @item.LastName</div>
                                        <small class="text-muted">Fire Station</small>
                                    </div>
                                </div>
                            </td>
                            <td style="vertical-align:middle;"><span class="text-muted">@item.Email</span></td>
                            <td class="text-center" style="vertical-align:middle;">
                                <div class="btn-group" role="group">
                                    <a asp-controller="Users" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-dark btn-sm" style="border-radius:6px 0 0 6px;">
                                        <i class="fas fa-pen"></i>
                                    </a>
                                    <a asp-controller="Users" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm" style="border-radius:0 6px 6px 0;">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("fireStation").addEventListener("keyup", function () {
            const v = this.value.toLowerCase();
            document.querySelectorAll("#fireStationTable tbody tr").forEach(r => r.style.display = r.textContent.toLowerCase().includes(v) ? "" : "none");
        });
    </script>
}