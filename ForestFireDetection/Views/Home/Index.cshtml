@{
    ViewData["Title"] = "Dashboard";
    Layout = "_Layout";
}

<!-- Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="gs-stat-card gs-stat-danger">
            <div class="gs-stat-card-body">
                <div class="gs-stat-icon"><i class="fas fa-fire-alt"></i></div>
                <div class="gs-stat-info">
                    <span class="gs-stat-number">@ViewBag.ActiveAlerts</span>
                    <span class="gs-stat-label">Active Alerts</span>
                </div>
            </div>
            <a asp-controller="Alerts" asp-action="Index" class="gs-stat-footer">
                View Details <i class="fas fa-arrow-right"></i>
            </a>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="gs-stat-card gs-stat-success">
            <div class="gs-stat-card-body">
                <div class="gs-stat-icon"><i class="fas fa-wifi"></i></div>
                <div class="gs-stat-info">
                    <span class="gs-stat-number">@ViewBag.OnlineSensors</span>
                    <span class="gs-stat-label">Online Sensors</span>
                </div>
            </div>
            <a asp-controller="Sensors" asp-action="Index" class="gs-stat-footer">
                View Details <i class="fas fa-arrow-right"></i>
            </a>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="gs-stat-card gs-stat-secondary">
            <div class="gs-stat-card-body">
                <div class="gs-stat-icon"><i class="fas fa-plug"></i></div>
                <div class="gs-stat-info">
                    <span class="gs-stat-number">@ViewBag.OfflineSensors</span>
                    <span class="gs-stat-label">Offline Sensors</span>
                </div>
            </div>
            <a asp-controller="Sensors" asp-action="Index" class="gs-stat-footer">
                View Details <i class="fas fa-arrow-right"></i>
            </a>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="gs-stat-card gs-stat-warning">
            <div class="gs-stat-card-body">
                <div class="gs-stat-icon"><i class="fas fa-burn"></i></div>
                <div class="gs-stat-info">
                    <span class="gs-stat-number">@Math.Round((double)ViewBag.MaxFireScore, 1)</span>
                    <span class="gs-stat-label">Max Fire Score</span>
                </div>
            </div>
            <a asp-controller="Alerts" asp-action="Index" class="gs-stat-footer">
                View Details <i class="fas fa-arrow-right"></i>
            </a>
        </div>
    </div>
</div>

<!-- Chart + Recent Alerts -->
<div class="row g-3">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h3 class="card-title mb-0"><i class="fas fa-chart-area me-2" style="color:var(--gs-green)"></i>Alerts — Last 24 Hours</h3>
                <span class="badge bg-light text-muted" style="font-size:.7rem;">Live</span>
            </div>
            <div class="card-body" style="padding:1rem 1.25rem;">
                <canvas id="alertsChart" height="115"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card" style="height:100%;max-height:460px;">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h3 class="card-title mb-0"><i class="fas fa-bell me-2" style="color:var(--gs-red)"></i>Recent Alerts</h3>
                <a asp-controller="Alerts" asp-action="Index" class="btn btn-sm" style="font-size:.72rem;color:var(--gs-green);">View All</a>
            </div>
            <div class="card-body p-0" style="overflow-y:auto;max-height:385px;">
                @if (ViewBag.RecentAlerts != null && ((IEnumerable<dynamic>)ViewBag.RecentAlerts).Any())
                {
                    @foreach (var alert in ViewBag.RecentAlerts)
                    {
                        var scoreVal = (double)alert.FireScore;
                        var scoreColor = scoreVal >= 75 ? "var(--gs-red)" : scoreVal >= 50 ? "var(--gs-yellow)" : "var(--gs-green)";
                        <div class="gs-recent-alert">
                            <div class="gs-recent-alert-dot" style="background:@scoreColor"></div>
                            <div class="gs-recent-alert-info">
                                <div class="gs-recent-alert-sensor">@alert.SensorId</div>
                                <div class="gs-recent-alert-time">@alert.Timestamp.ToString("MMM dd, HH:mm")</div>
                            </div>
                            <div class="gs-recent-alert-right">
                                <span class="badge rounded-pill @(alert.Status == "NotReviewed" ? "bg-warning text-dark" :
                                                                          alert.Status == "InReview" ? "bg-info" : "bg-success")" style="font-size:.65rem;">
                            @(alert.Status == "NotReviewed" ? "Pending" : alert.Status == "InReview" ? "In Review" : "Resolved")
                        </span>
                        <div class="gs-recent-alert-score" style="color:@scoreColor">@Math.Round(scoreVal, 1)%</div>
                    </div>
                </div>
                                }
                }
                else
                {
                    <div style="text-align:center;padding:60px 20px;color:var(--gs-gray-500);">
                        <i class="fas fa-shield-alt" style="font-size:2.5rem;color:var(--gs-green);margin-bottom:12px;display:block;"></i>
                        <p style="font-weight:600;margin:0;">All Clear</p>
                        <small>No recent alerts detected</small>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const ctx = document.getElementById('alertsChart').getContext('2d');
        const gradient = ctx.createLinearGradient(0, 0, 0, 300);
        gradient.addColorStop(0, 'rgba(34, 197, 94, 0.2)');
        gradient.addColorStop(1, 'rgba(34, 197, 94, 0)');

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: @Html.Raw(Json.Serialize(ViewBag.ChartLabels)),
                datasets: [{
                    label: 'Alerts',
                    data: @Html.Raw(Json.Serialize(ViewBag.ChartData)),
                    borderWidth: 2,
                    borderColor: '#22c55e',
                    backgroundColor: gradient,
                    fill: true,
                    tension: 0.4,
                    pointBackgroundColor: '#fff',
                    pointBorderColor: '#22c55e',
                    pointBorderWidth: 2,
                    pointRadius: 3,
                    pointHoverRadius: 5
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                interaction: { intersect: false, mode: 'index' },
                scales: {
                    y: { beginAtZero: true, ticks: { precision: 0, font: { size: 11 } }, grid: { color: '#f1f5f9' } },
                    x: { grid: { display: false }, ticks: { font: { size: 11 } } }
                },
                plugins: {
                    legend: { display: false },
                    tooltip: { backgroundColor: '#111827', titleFont: { size: 12, weight: '600' }, bodyFont: { size: 11 }, cornerRadius: 8, padding: 10 }
                }
            }
        });
    </script>
}