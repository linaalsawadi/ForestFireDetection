@model List<ForestFireDetection.Models.Sensor>
@{
    ViewData["Title"] = "Data Reports";
}

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card card-success card-outline" style="height:100%;">
            <div class="card-header">
                <h3 class="card-title mb-0"><i class="fas fa-microchip me-2"></i>Select Sensor</h3>
            </div>
            <div class="card-body">
                <label class="form-label fw-bold" style="font-size:.82rem;color:var(--gs-gray-700);">Sensor</label>
                <select id="sensorSelect" class="form-control" style="border-radius:10px;">
                    <option value="">— Choose a sensor —</option>
                    @foreach (var sensor in Model)
                    {
                        <option value="@sensor.SensorId">@sensor.SensorId — @(sensor.SensorState == "red" ? "Critical" : sensor.SensorState == "yellow" ? "Warning" : sensor.SensorState == "green" ? "Normal" : "Offline")</option>
                    }
                </select>
                <button id="viewReportBtn" class="btn btn-success w-100 mt-3" style="border-radius:10px;">
                    <i class="fas fa-chart-line me-1"></i> View Daily Report
                </button>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card card-success card-outline" style="height:100%;">
            <div class="card-header">
                <h3 class="card-title mb-0"><i class="fas fa-calendar-alt me-2"></i>Select Date</h3>
            </div>
            <div class="card-body d-flex justify-content-center">
                <div id="calendar" style="width:100%;max-width:400px;"></div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tempusdominus-bootstrap-4/5.39.0/css/tempusdominus-bootstrap-4.min.css" />
}
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tempusdominus-bootstrap-4/5.39.0/js/tempusdominus-bootstrap-4.min.js"></script>
    <script>
        $(function () {
            $('#calendar').datetimepicker({ format: 'L', inline: true });
            $('#viewReportBtn').on('click', function () {
                const s = $('#sensorSelect').val(), d = $('#calendar').datetimepicker('viewDate');
                if (!s) { alert('Please select a sensor.'); return; }
                window.location.href = `/Sensors/DailyReport?sensorId=${s}&date=${d.format('YYYY-MM-DD')}`;
            });
        });
    </script>
}
